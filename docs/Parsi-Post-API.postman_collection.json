        ],
        "url": {
          "raw": "{{baseUrl}}/Ordering/ClientOrder/GetApiServiceType?senderCityId={{senderCityId}}&receiverCityId={{senderCityId}}&contractId={{contractId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "Ordering",
            "ClientOrder",
            "GetApiServiceType"
          ],
          "query": [
            {
              "key": "senderCityId",
              "value": "{{senderCityId}}"
            },
            {
              "key": "receiverCityId",
              "value": "{{senderCityId}}"
            },
            {
              "key": "contractId",
              "value": "{{contractId}}"
            }
          ]
        },
        "description": "**GET** `/Ordering/ClientOrder/GetApiServiceType`\n\nReturns the service types (tariffs) available between two cities for a contract. Pass `senderCityId`, `receiverCityId`, `contractId` as query parameters."
      },
      "response": []
    },
