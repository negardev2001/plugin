          "mode": "raw",
          "raw": "{\n  \"contractId\": \"{{contractId}}\",\n  \"isForeign\": false,\n  \"serviceTypeId\": \"{{serviceTypeId}}\",\n  \"insuranceTypeId\": \"{{insuranceTypeId}}\",\n  \"deadLineId\": \"{{deadlineId}}\",\n  \"senderCityId\": \"{{senderCityId}}\",\n  \"senderPostalCode\": \"8917171717\",\n  \"receiverCityId\": \"{{senderCityId}}\",\n  \"parcelTypeId\": \"{{parcelTypeId}}\",\n  \"boxTypeId\": \"{{boxTypeId}}\",\n  \"weight\": 1000,\n  \"priceValue\": 100000,\n  \"packingPrice\": 10000,\n  \"parcelExtraServices\": []\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
