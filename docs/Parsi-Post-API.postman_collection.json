    {
      "name": "7. Save & Pay Order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "office",
            "value": "{{office}}",
            "type": "text",
            "description": "Required. Office GUID (OfficeId). Without it the API returns 403."
          },
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text",
            "description": "Required. Your API key. Without it the API returns 401."
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/Ordering/ClientOrder/Save",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "Ordering",
            "ClientOrder",
            "Save"
          ]
        },
        "description": "**POST** `/Ordering/ClientOrder/Save`\n\n⚠️ **Creates and pays for a real order.** Do not run casually with a live contract.\n\nTop-level fields are the sender + payment; each entry in `parcels[]` is one shipment to a receiver. `senderLocation`/`receiverLocation` are `\"lat,long\"` with no spaces. On success the response contains a tracking barcode.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"contractId\": \"{{contractId}}\",\n  \"senderCityId\": \"{{senderCityId}}\",\n  \"senderFirstName\": \"AmirHossein\",\n  \"senderLastName\": \"Abdollahi\",\n  \"senderAddress\": \"آدرس فرستنده\",\n  \"senderPostalCode\": \"8917171717\",\n  \"senderAddressTitle\": \"home\",\n  \"senderLocation\": \"31.856412680380018,54.32582994401454\",\n  \"senderNationalCode\": \"4421234729\",\n  \"senderMobile\": \"09135127340\",\n  \"paymentTypeId\": \"{{paymentTypeId}}\",\n  \"parcels\": [\n    {\n      \"ServiceTypeId\": \"{{serviceTypeId}}\",\n      \"DeadlineId\": \"{{deadlineId}}\",\n      \"receiverCityId\": \"{{senderCityId}}\",\n      \"receiverFirstName\": \"گیرنده\",\n      \"receiverLastName\": \"نمونه\",\n      \"receiverPostalCode\": \"8912121212\",\n      \"receiverNationalCode\": \"4441234729\",\n      \"receiverMobile\": \"09202066830\",\n      \"receiverAddress\": \"آدرس گیرنده\",\n      \"receiverLocation\": \"31.893744621198657,54.30864612794557\",\n      \"receiverAddress2\": \"\",\n      \"insuranceTypeId\": \"{{insuranceTypeId}}\",\n      \"parcelTypeId\": \"{{parcelTypeId}}\",\n      \"boxTypeId\": \"{{boxTypeId}}\",\n      \"weight\": 1000,\n      \"content\": \"بسته\",\n      \"parcelExtraServices\": []\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    }
