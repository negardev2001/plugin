# New shipping fields translations
#: parsi.php:403
msgid "Free Shipping Threshold"
msgstr "آستانه ارسال رایگان"

#: parsi.php:405
msgid "Minimum order amount for free shipping. If order total exceeds this amount, shipping will be free. 0 means this feature is disabled."
msgstr "حداقل مبلغ سفارش برای ارسال رایگان. اگر مبلغ سفارش از این مقدار بیشتر باشد، هزینه ارسال رایگان خواهد بود. 0 به معنای غیرفعال بودن این قابلیت است."

#: parsi.php:418
msgid "Delivery Time Estimate"
msgstr "برآورد زمان تحویل"

#: parsi.php:420
msgid "Text to display delivery time estimate on checkout page for customers. Example: 3-5 business days"
msgstr "متن نمایش زمان تحویل در صفحه پرداخت برای مشتری. مثال: 3-5 روز کاری"

#: parsi.php:433
msgid "Shipping Insurance"
msgstr "بیمه ارسال"

#: parsi.php:435
msgid "Enable shipping insurance for all shipments. Insurance cost will be automatically added to shipping cost."
msgstr "فعال‌سازی بیمه ارسال برای تمام مرسولات. هزینه بیمه به صورت خودکار به هزینه ارسال اضافه می‌شود."

#: parsi.php:448
msgid "COD Fee"
msgstr "کارمزد پرداخت در محل"

#: parsi.php:450
msgid "Additional fee for Cash on Delivery (COD). This amount will be added to shipping cost. 0 means no fee."
msgstr "کارمزد اضافی برای پرداخت در محل (COD). این مبلغ به هزینه ارسال اضافه می‌شود. 0 به معنای بدون کارمزد است."

#: parsi.php:463
msgid "Packaging Type"
msgstr "نوع بسته‌بندی"

#: parsi.php:465
msgid "Default packaging type for shipping rate calculation."
msgstr "نوع بسته‌بندی پیش‌فرض برای محاسبه هزینه ارسال."

#: parsi.php:470
msgid "Standard"
msgstr "استاندارد"

#: parsi.php:471
msgid "Express"
msgstr "اکسپرس"

#: parsi.php:472
msgid "Fragile"
msgstr "قابل‌شکن"

#: parsi.php:473
msgid "Bulk"
msgstr "حجمی"

