#: parsi.php:4
msgid "PARSI - WooCommerce Shipping Integration"
msgstr "پارسی پست - افزونه ارسال ووکامرس"

#: parsi.php:5
msgid "A WooCommerce shipping plugin that calculates shipping rates using an external shipping API."
msgstr "یک افزونه ارسال برای ووکامرس که هزینه ارسال را با استفاده از API خارجی محاسبه می‌کند."

#: parsi.php:7
msgid "parsi"
msgstr "parsi"

#: parsi.php:176
msgid "PARSI Shipping"
msgstr "ارسال با پارسی پست"

#: parsi.php:177
msgid "requires WooCommerce to be installed and active."
msgstr "نیاز به نصب و فعال بودن ووکامرس دارد."

