#: parsi.php:413
msgid "Configure your shipping API credentials and endpoint."
msgstr "اطلاعات احراز هویت و آدرس API ارسال را پیکربندی کنید."

#: parsi.php:426
msgid "Configure shipping options and preferences."
msgstr "تنظیمات و ترجیحات ارسال را پیکربندی کنید."

#: parsi.php:436
msgid "Enter your API key"
msgstr "کلید API خود را وارد کنید"

#: parsi.php:438
msgid "Enter your API key for authentication with the shipping API."
msgstr "کلید API خود را برای احراز هویت با سرویس ارسال وارد کنید."

#: parsi.php:451
msgid "Enter the API endpoint URL for shipping rate calculations."
msgstr "آدرس نقطه پایانی API برای محاسبه هزینه ارسال را وارد کنید."

#: parsi.php:469
msgid "Select the HTTP method to use for API requests."
msgstr "متد HTTP برای درخواست‌های API را انتخاب کنید."

#: parsi.php:483
msgid "Additional handling fee to add to shipping rates (optional)."
msgstr "کارمزد اضافی برای افزودن به هزینه ارسال (اختیاری)."

#: parsi.php:498
msgid "Enable logging for API requests and errors"
msgstr "ثبت وقایع برای درخواست‌ها و خطاهای API فعال شود"

#: parsi.php:512
msgid "Enter default method ID"
msgstr "شناسه روش پیش‌فرض را وارد کنید"

#: parsi.php:513
msgid "Default shipping method ID to use if API returns multiple options (optional)."
msgstr "شناسه روش ارسال پیش‌فرض در صورت بازگشت چندین گزینه از API (اختیاری)."

#: parsi.php:526
msgid "The city from which shipments originate (store location)."
msgstr "شهری که ارسال‌ها از آن انجام می‌شود (موقعیت فروشگاه)."

#: parsi.php:542
msgid "Enable real-time shipping cost calculation via API during checkout."
msgstr "محاسبه هزینه ارسال به صورت زنده از طریق API در صفحه پرداخت."

#: parsi.php:558
msgid "Enable debug mode for detailed API logging (requires logging enabled)."
msgstr "فعال‌سازی حالت عیب‌یابی برای ثبت وقایع دقیق API (نیاز به فعال بودن ثبت وقایع)."

#: parsi.php:569
msgid "You do not have sufficient permissions to access this page."
msgstr "شما دسترسی کافی برای مشاهده این صفحه را ندارید."

#: parsi.php:582
msgid "Settings saved successfully."
msgstr "تنظیمات با موفقیت ذخیره شد."

#: parsi.php:623
msgid "Save Settings"
msgstr "ذخیره تنظیمات"

#: parsi.php:633
msgid "Shipment Status Sync"
msgstr "همگام‌سازی وضعیت ارسال"

#: parsi.php:635
msgid "Manually sync shipment status from Parsi API."
msgstr "همگام‌سازی دستی وضعیت ارسال از API پارسی پست."

#: parsi.php:638
msgid "Sync Now"
msgstr "همگام‌سازی اکنون"

#: parsi.php:648
msgid "Logs"
msgstr "وقایع"

#: parsi.php:650
msgid "View recent API request logs and errors."
msgstr "مشاهده وقایع اخیر درخواست‌ها و خطاهای API."

#: parsi.php:652
msgid "View WooCommerce Logs"
msgstr "مشاهده وقایع ووکامرس"

